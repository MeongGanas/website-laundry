# Contoh Konfigurasi Nginx untuk Server Armbian / Ubuntu Anda
# Salin file ini ke: /etc/nginx/sites-available/api.meongganas.my.id
# Lalu aktifkan: sudo ln -sf /etc/nginx/sites-available/api.meongganas.my.id /etc/nginx/sites-enabled/
# Dan restart: sudo nginx -t && sudo systemctl restart nginx

server {
    listen 80;
    server_name api.meongganas.my.id; # Sesuaikan dengan subdomain / domain Anda

    # Sesuaikan dengan path asli folder proyek di server Anda (cek via 'pwd'):
    root /var/www/website-laundry/server/public;

    index index.php index.html;
    charset utf-8;

    # Routing Laravel Umum
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Proteksi Rate Limiting API (memerlukan limit_req_zone di /etc/nginx/nginx.conf)
    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Proteksi Khusus Login dari Brute-Force
    location = /api/login {
        limit_req zone=login_limit burst=3 nodelay;
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        # Menyesuaikan dengan socket PHP yang aktif di server (misal php8.5-fpm.sock):
        fastcgi_pass unix:/var/run/php/php8.5-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
